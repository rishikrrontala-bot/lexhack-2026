{
  "name": "in-its-place",
  "private": true,
  "version": "1.0.0",
  "description": "Paste a D.C. bill, read the law it would make. A deterministic amendment compiler for the D.C. Official Code, measured against the Council's codifiers.",
  "author": "Rishik Rontala",
  "license": "MIT",
  "type": "module",
  "engines": { "node": ">=20" },
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "data": "tsx scripts/build-data.ts",
    "bench": "tsx scripts/benchmark.ts"
  },
  "dependencies": {
    "@fontsource/charis-sil": "5.3.0",
    "@fontsource-variable/public-sans": "5.3.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.19.1",
    "domhandler": "6.0.1",
    "htmlparser2": "12.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
